# Resend API key for the contact form (https://resend.com/api-keys).
RESEND_API_KEY=

# Optional. Must be from a domain verified in Resend.
# Until a custom domain is verified, leave blank to fall back to
# "Taymar Site <onboarding@resend.dev>" which Resend allows only when
# the recipient is the account holder.
CONTACT_FROM_EMAIL=Taymar Site <noreply@taymarsolutions.com>
